generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String               @id @default(cuid())
  name                     String
  email                    String               @unique
  emailVerified            Boolean              @default(false)
  image                    String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  role                     UserRole             @default(DONOR)
  banned                   Boolean              @default(false)
  banReason                String?
  banExpires               DateTime?
  bloodGroup               BloodGroup?
  phone                    String?
  whatsappNumber           String?
  phoneNumber              String?
  location                 String?
  age                      Int?
  pushToken                String?
  avatarUrl                String?
  lastDonation             DateTime?
  eligible                 Boolean              @default(true)
  facilityId               String?
  licenseNo                String?
  passwordHash             String?
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  age                      Int?
  location                 String?
  whatsappNumber           String?
  phoneNumber              String?
  pushToken                String?
  avatarUrl                String?
  campaignInvitations      CampaignInvitation[]
  googleAccounts           GoogleAccount[]
  notifications            Notification[]
  refreshTokens            RefreshToken[]
  requisitions             Requisition[]
  transfusions             TransfusionLog[]
  facility                 Facility?            @relation(fields: [facilityId], references: [id])

  @@index([role])
  @@index([email])
  @@index([facilityId])
  @@map("user")
}

model Facility {
  id           String        @id @default(cuid())
  name         String
  type         String
  address      String?
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  requisitions Requisition[]
  users        User[]

  @@index([type])
  @@map("facility")
}

model BloodInventory {
  id           String         @id @default(cuid())
  bloodGroup   BloodGroup
  component    BloodComponent @default(WHOLE_BLOOD)
  units        Int            @default(0)
  minThreshold Int            @default(15)
  expiresAt    DateTime?
  updatedAt    DateTime       @updatedAt

  @@unique([bloodGroup, component])
  @@index([bloodGroup])
  @@map("blood_inventory")
}

model Requisition {
  id           String            @id @default(cuid())
  requesterId  String
  patientName  String?
  patientRef   String?
  bloodGroup   BloodGroup
  component    BloodComponent    @default(WHOLE_BLOOD)
  unitsNeeded  Int
  urgency      Urgency           @default(ROUTINE)
  status       RequisitionStatus @default(PENDING)
  clinicalNote String?
  facilityId   String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  facility     Facility?         @relation(fields: [facilityId], references: [id])
  requester    User              @relation(fields: [requesterId], references: [id])

  @@index([status])
  @@index([requesterId])
  @@index([facilityId])
  @@map("requisition")
}

model TransfusionLog {
  id             String         @id @default(cuid())
  administeredBy String
  patientRef     String
  bloodGroup     BloodGroup
  component      BloodComponent @default(WHOLE_BLOOD)
  unitsUsed      Int            @default(1)
  vitalsStable   Boolean        @default(true)
  notes          String?
  createdAt      DateTime       @default(now())
  staff          User           @relation(fields: [administeredBy], references: [id])

  @@index([administeredBy])
  @@map("transfusion_log")
}

model Campaign {
  id               String               @id @default(cuid())
  title            String
  description      String?
  location         String?
  bloodGroup       BloodGroup?
  targetUnits      Int                  @default(10)
  status           CampaignStatus       @default(DRAFT)
  startDate        DateTime?
  endDate          DateTime?
  createdBy        String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  availableItems   String[]             @default([])
  contactName      String?
  contactPhone     String?
  contactWhatsApp  String?
  imageUrl         String?
  latitude         Float?
  locationName     String?
  longitude        Float?
  notificationType String               @default("info")
  services         String[]             @default([])
  invitations      CampaignInvitation[]

  @@index([status])
  @@map("campaign")
}

model CampaignInvitation {
  id          String           @id @default(cuid())
  campaignId  String
  donorId     String
  status      InvitationStatus @default(PENDING)
  sentAt      DateTime         @default(now())
  respondedAt DateTime?
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donor       User             @relation(fields: [donorId], references: [id])

  @@index([campaignId])
  @@index([donorId])
  @@map("campaign_invitation")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  relatedId String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notification")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_token")
}

model GoogleAccount {
  id        String   @id @default(cuid())
  userId    String
  googleSub String   @unique
  email     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("google_account")
}

enum UserRole {
  DONOR
  NURSE
  DOCTOR
  MANAGER
  ADMIN
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum BloodComponent {
  WHOLE_BLOOD
  Packed_RBC
  PLASMA
  PLATELETS
}

enum Urgency {
  ROUTINE
  URGENT
  EMERGENCY
}

enum RequisitionStatus {
  PENDING
  APPROVED
  DISPATCHED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum NotificationType {
  INVITATION
  CAMPAIGN_JOIN
  CAMPAIGN_ACCEPT
  CAMPAIGN_DECLINE
  REQUISITION
  SYSTEM
}
