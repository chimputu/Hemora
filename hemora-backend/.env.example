# Database
DATABASE_URL="postgresql://username:password@localhost:5432/hemora?schema=public"

# JWT Configuration
# Generate strong random secrets for production!
# Example: openssl rand -base64 32
JWT_SECRET="hemora-jwt-secret-change-this-in-production"
JWT_REFRESH_SECRET="hemora-refresh-secret-change-this-in-production"

# AI Service
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_API_KEY="hemora-ai-api-key-change-this-in-production"

# Google OAuth
# Get your Client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Server
PORT=5000

# Email / SMTP
# Configure your SMTP provider (e.g., Gmail, Mailtrap, SendGrid)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="noreply@hemora.zm"

# App Base URL (used in email links)
# APP_BASE_URL="http://localhost:8081"

# Optional: CORS origins for production (comma-separated)
# CORS_ORIGINS="https://yourdomain.com"

# Optional: Node environment (development or production)
# NODE_ENV="production"
